# mock | live | auto (default). `auto` probes the backend once and falls back
# to the fixture transport when it is not up.
NEXT_PUBLIC_API_MODE=auto

# Where the Go backend listens. The Next route handler at /api/v1/* proxies to
# it, so the browser only ever talks to one origin.
BACKEND_ORIGIN=http://localhost:8080

# For live demos: fail loudly instead of silently rendering fixture data when
# the backend is down. "auto" (default) falls back to mocks for development.
# NEXT_PUBLIC_API_MODE=live
