# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and holds no secrets. The root
# .gitignore already re-includes it, but a nested rule wins over a parent one
# for files in this directory, so the negation has to be repeated here.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
